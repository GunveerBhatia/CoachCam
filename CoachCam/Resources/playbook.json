  "lighting": [
    { "id": "light.harsh", "when": "harsh", "appliesTo": ["people"], "steps": ["Move into open shade", "Face toward open sky", "Can't move? Put the sun behind them"] },
    { "id": "light.backlit", "when": "backlit", "appliesTo": ["people"], "steps": ["Light is behind you, turn around"] },
    { "id": "light.sideDark", "when": "sideDark", "appliesTo": ["people"], "steps": ["Turn toward the window/light"] },
    { "id": "light.dark", "when": "dark", "appliesTo": ["people", "building", "food", "sky", "object", "general"], "steps": ["Find more light or hold still"] },
    { "id": "light.foodFront", "when": "harsh", "appliesTo": ["food"], "steps": ["Light from the side, not the front"] }
