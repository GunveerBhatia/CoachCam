      "camera": { "height": "Chest height", "angle": "Level", "pitchMin": -5, "pitchMax": 10 },
      "framing": { "placement": "Subject on the nearest third", "headroom": "Some space above the head", "crop": "Never at a joint" },
      "lighting": ["Open shade is best", "Avoid harsh overhead sun"],
      "pose": ["Relax, weight on one leg", "Hands in pockets or holding something", "Look off to the side, then to the lens", "Small natural smile"],
      "autoSettings": { "exposure": "face", "hdr": "auto", "whiteBalance": "skin" },
      "source": "SPEC: General; Poses (Casual vibe)"
    },
    {
      "id": "people.street",
      "category": "people", "photoType": "street",
