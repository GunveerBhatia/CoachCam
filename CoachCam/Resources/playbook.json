{
  "_readme": "Coaching rules = detection + photo type. Built from docs/SPEC.md. Each rule: category (people/building/food/sky/object/general), optional photoType, optional match {people: 1|2|3|4+, camera: front|back, props: [...], personTypes: [...]}. The app picks the exact match or the closest one and shows which in the debug overlay. Keep tips under ~8 words. pitch: + = phone pointing down, - = pointing up.",
  "version": 1,

  "rules": [
    {
      "id": "people.headshot",
      "category": "people", "photoType": "headshot",
      "match": { "people": "1", "camera": "back" },
      "lens": { "zoom": 4, "fallbackZoom": 2, "note": "About 85–100mm flatters faces. Too close for 4x: use 2x and step back." },
      "camera": { "height": "Eye level or slightly above", "angle": "Level", "pitchMin": -5, "pitchMax": 10 },
      "framing": { "placement": "Eyes on the upper third", "headroom": "Small gap above the head", "crop": "Mid-chest; never at a joint" },
      "lighting": ["Face toward soft light", "Avoid overhead midday sun"],
      "pose": ["Angle your body 30–45° away", "Turn your head back to the lens", "Chin forward and slightly down", "Drop your shoulders", "Lean slightly toward the lens", "Tilt head 5° at most", "Eyes on the lens, not the screen"],
      "autoSettings": { "exposure": "face", "hdr": "auto", "lowLight": "quality", "shutter": "normal", "whiteBalance": "skin", "depth": true },
      "source": "SPEC: Headshot / pro; Lens choice"
    },
    {
      "id": "people.headshot.front",
      "category": "people", "photoType": "headshot",
      "match": { "people": "1", "camera": "front" },
      "lens": { "zoom": 1, "note": "Front camera. Hold the phone at arm's length to avoid face distortion." },
      "camera": { "height": "Slightly above eye level", "angle": "Tilted slightly down", "pitchMin": -20, "pitchMax": 0 },
      "framing": { "placement": "Eyes on the upper third", "headroom": "Small gap above the head", "notes": ["Warn if the phone is too close (distortion)"] },
      "lighting": ["Turn toward the light"],
      "pose": ["Chin forward and slightly down", "Turn your face toward the light", "Relax your shoulders", "Eyes on the lens"],
      "autoSettings": { "exposure": "face", "hdr": "auto", "whiteBalance": "skin" },
      "source": "SPEC: Front selfie"
    },
    {
      "id": "people.pro",
      "category": "people", "photoType": "pro",
      "match": { "people": "1" },
      "lens": { "zoom": 4, "fallbackZoom": 2, "note": "Step back rather than going wider." },
      "camera": { "height": "Eye level or slightly above", "angle": "Level", "pitchMin": -5, "pitchMax": 10 },
      "framing": { "placement": "Centred or on a third; plain background", "headroom": "Small", "crop": "Mid-chest or waist; never at a joint" },
      "lighting": ["Soft, even light on the face", "Plain wall or office background"],
      "pose": ["Angle your body 30–45° away", "Turn your head back to the lens", "Chin forward and slightly down", "Shoulders down and relaxed", "Small lean toward the lens", "Eyes on the lens"],
      "autoSettings": { "exposure": "face", "hdr": "auto", "whiteBalance": "skin", "depth": true },
      "source": "SPEC: Headshot / pro"
    },
    {
      "id": "people.portrait",
      "category": "people", "photoType": "portrait",
      "match": { "people": "1" },
      "lens": { "zoom": 2, "fallbackZoom": 1, "note": "Half-body portrait at 48mm." },
      "camera": { "height": "Chest to eye level", "angle": "Level", "pitchMin": -5, "pitchMax": 10 },
      "framing": { "placement": "Subject on the nearest third", "headroom": "Small", "crop": "Waist or mid-thigh; never at knees or elbows" },
      "lighting": ["Soft light from the side or front"],
      "pose": ["Angle your body slightly away", "Weight on your back leg", "Turn your face to the lens", "Relax your hands"],
      "autoSettings": { "exposure": "face", "hdr": "auto", "whiteBalance": "skin", "depth": true },
      "source": "SPEC: General; Headshot / pro"
    },
    {
      "id": "people.casual",
      "category": "people", "photoType": "casual",
