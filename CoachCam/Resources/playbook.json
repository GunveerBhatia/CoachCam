    "notHarsh":       { "id": "notHarsh", "text": "Move into open shade", "arrow": "none", "check": { "type": "notHarsh" } },
    "overhead":       { "id": "overhead", "text": "Raise to overhead", "textFor": { "tiltDown": "Point phone straight down", "tiltUp": "Ease back, too far over" }, "arrow": "auto", "check": { "type": "pitch", "min": 80, "max": 95 } },
    "fortyFive":      { "id": "fortyFive", "text": "Hold phone at about 45°", "textFor": { "tiltDown": "Tilt down to 45°", "tiltUp": "Lower to 45°" }, "arrow": "auto", "check": { "type": "pitch", "min": 35, "max": 55 } },
    "straightOn":     { "id": "straightOn", "text": "Shoot straight on, food level", "textFor": { "tiltDown": "Tilt down a little", "tiltUp": "Lower phone to food level" }, "arrow": "auto", "check": { "type": "pitch", "min": -5, "max": 15 } },
    "lowAngle":       { "id": "lowAngle", "text": "Crouch low, point up", "textFor": { "tiltUp": "Point phone up more", "tiltDown": "Not so steep" }, "arrow": "auto", "check": { "type": "pitch", "min": -70, "max": -25 } },
    "objectSize":     { "id": "objectSize", "text": "Fill the frame with it", "textFor": { "stepCloser": "Move closer", "stepBack": "Back up a little" }, "arrow": "auto", "check": { "type": "subjectSize", "measure": "area", "min": 0.08, "max": 0.6 } },
    "wipeRim":        { "id": "wipeRim", "text": "Wipe the plate rim", "arrow": "none", "check": { "type": "manual" } },
    "sideLight":      { "id": "sideLight", "text": "Light from the side, not front", "arrow": "none", "check": { "type": "manual" } },
    "horizonThird":   { "id": "horizonThird", "text": "Horizon on a third line", "arrow": "none", "check": { "type": "manual" } },
    "foreground":     { "id": "foreground", "text": "Add something in the foreground", "arrow": "none", "check": { "type": "manual" } },
    "mirrorDistance": { "id": "mirrorDistance", "text": "Stand 4–5 ft from the mirror", "arrow": "none", "check": { "type": "manual" } },
    "phoneChest":     { "id": "phoneChest", "text": "Phone at chest height", "arrow": "none", "check": { "type": "manual" } },
    "phoneAside":     { "id": "phoneAside", "text": "Hold phone slightly to the side", "arrow": "none", "check": { "type": "manual" } },
    "selfieAbove":    { "id": "selfieAbove", "text": "Phone slightly above eye level", "textFor": { "tiltDown": "Tilt phone down a little", "tiltUp": "Tilt phone up a little" }, "arrow": "auto", "check": { "type": "pitch", "min": -20, "max": -2 } }
  },

  "rules": [
    {
