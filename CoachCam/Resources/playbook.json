      "camera": { "height": "Chest height; higher vantage point if it doesn't fit", "angle": "Phone perfectly level", "pitchMin": -3, "pitchMax": 3 },
      "framing": { "placement": "Symmetrical: dead centre. Otherwise: thirds.", "notes": ["If you tilt up: keep phone level, step back", "Offer vertical-line correction after capture"] },
      "lighting": ["Golden hour: warm, textured facades", "Blue hour (20–30 min after sunset): lit buildings"],
      "autoSettings": { "exposure": "balanced", "hdr": "on", "lowLight": "merge", "whiteBalance": "auto" },
      "source": "SPEC: Building / architecture; Lens choice"
    },
    {
      "id": "building.details",
      "category": "building", "photoType": "details",
      "lens": { "zoom": 4, "fallbackZoom": 8, "note": "Zoom in on patterns, windows, doors, textures." },
      "camera": { "height": "Straight on to the detail", "angle": "Square to the surface", "pitchMin": -10, "pitchMax": 10 },
      "framing": { "placement": "Fill the frame with the pattern", "notes": ["Repeat patterns edge to edge"] },
      "lighting": ["Side light brings out texture"],
      "autoSettings": { "exposure": "balanced", "hdr": "auto", "shutter": "fast" },
      "source": "SPEC: Building / architecture"
    },
    {
      "id": "building.lowAngle",
      "category": "building", "photoType": "lowAngle",
