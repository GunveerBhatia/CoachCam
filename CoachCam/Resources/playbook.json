{
  "_readme": "Coaching rules = detection + photo type. Built from docs/SPEC.md. Each rule: category (people/building/food/sky/object/general), optional photoType, optional match {people: 1|2|3|4+, camera: front|back, props: [...], personTypes: [...]}. The app picks the exact match or the closest one and shows which in the debug overlay. Keep tips under ~8 words. pitch: + = phone pointing down, - = pointing up.",
  "version": 2,

  "stepLibrary": {
    "level":          { "id": "level", "text": "Straighten your phone", "arrow": "auto", "check": { "type": "level", "max": 1.5 } },
    "pitchLevel":     { "id": "pitchLevel", "text": "Keep phone level", "textFor": { "tiltDown": "Tilt phone down to level", "tiltUp": "Tilt phone up to level" }, "arrow": "auto", "check": { "type": "pitch", "min": -4, "max": 4 } },
    "steady":         { "id": "steady", "text": "Hold still", "arrow": "none", "check": { "type": "steady", "max": 0.08 } },
    "eyeLevel":       { "id": "eyeLevel", "text": "Camera at eye level", "textFor": { "raisePhone": "You: raise phone to eye level", "lowerPhone": "You: lower phone to eye level" }, "arrow": "auto", "check": { "type": "eyeLevel", "min": 0.25, "max": 0.42 } },
    "slightlyAbove":  { "id": "slightlyAbove", "text": "Camera slightly above eyes", "textFor": { "raisePhone": "You: raise phone a little", "lowerPhone": "You: lower phone a little" }, "arrow": "auto", "check": { "type": "eyeLevel", "min": 0.36, "max": 0.55 } },
    "headInFrame":    { "id": "headInFrame", "text": "Step back, head is cut off", "arrow": "stepBack", "check": { "type": "headInFrame", "min": 0.01 } },
    "headroom":       { "id": "headroom", "text": "Fix space above the head", "textFor": { "tiltUp": "Tilt up, leave room above head", "tiltDown": "Tilt down, too much empty space" }, "arrow": "auto", "check": { "type": "headroom", "min": 0.03, "max": 0.15 } },
    "headshotSize":   { "id": "headshotSize", "text": "Frame head and shoulders", "textFor": { "stepCloser": "You: step closer", "stepBack": "You: step back a little" }, "arrow": "auto", "check": { "type": "subjectSize", "measure": "faceArea", "min": 0.05, "max": 0.2 } },
    "halfBodySize":   { "id": "halfBodySize", "text": "Frame from the waist up", "textFor": { "stepCloser": "You: step closer", "stepBack": "You: step back" }, "arrow": "auto", "check": { "type": "subjectSize", "measure": "faceArea", "min": 0.015, "max": 0.05 } },
    "fullBody":       { "id": "fullBody", "text": "Fit them head to toe", "arrow": "stepBack", "check": { "type": "fullBody", "min": 0.02 } },
    "noJointCrop":    { "id": "noJointCrop", "text": "Don't crop at knees or ankles", "textFor": { "stepBack": "Step back, don't cut at joints" }, "arrow": "auto", "check": { "type": "noJointCrop", "max": 0.03 } },
    "thirds":         { "id": "thirds", "text": "Put them on a third line", "textFor": { "moveLeft": "Move phone left a little", "moveRight": "Move phone right a little" }, "arrow": "auto", "check": { "type": "placement", "target": "thirds", "max": 0.07 } },
    "center":         { "id": "center", "text": "Center the subject", "textFor": { "moveLeft": "Move phone left a little", "moveRight": "Move phone right a little" }, "arrow": "auto", "check": { "type": "placement", "target": "center", "max": 0.06 } },
    "bodyAngled":     { "id": "bodyAngled", "text": "Angle body 30–45° away", "textFor": { "subjectTurnLeft": "Turn your body a little", "subjectTurnRight": "Turn back toward camera a bit" }, "arrow": "auto", "check": { "type": "bodyAngle", "min": 0.35, "max": 0.8 } },
    "faceToLens":     { "id": "faceToLens", "text": "Turn your face to the lens", "textFor": { "subjectTurnLeft": "Turn your head to the lens", "subjectTurnRight": "Turn your head to the lens" }, "arrow": "auto", "check": { "type": "faceYaw", "min": -12, "max": 12 } },
    "headStraight":   { "id": "headStraight", "text": "Keep your head straight", "arrow": "subjectStraightenHead", "check": { "type": "faceRoll", "max": 6 } },
    "chinDown":       { "id": "chinDown", "text": "Chin forward and slightly down", "arrow": "subjectChinDown", "check": { "type": "manual" } },
    "shouldersDown":  { "id": "shouldersDown", "text": "Drop and relax your shoulders", "arrow": "none", "check": { "type": "manual" } },
    "eyesToLens":     { "id": "eyesToLens", "text": "Eyes on the lens, not the screen", "arrow": "subjectFaceLens", "check": { "type": "manual" } },
    "weightOneLeg":   { "id": "weightOneLeg", "text": "Weight on one leg, knee bent", "arrow": "none", "check": { "type": "manual" } },
    "closeGap":       { "id": "closeGap", "text": "Close the gap, shoulders touching", "arrow": "subjectCloseGap", "check": { "type": "gap", "max": 0.02 } },
    "staggerHeads":   { "id": "staggerHeads", "text": "Heads at different heights", "arrow": "subjectStaggerHeads", "check": { "type": "staggered", "min": 0.04 } },
