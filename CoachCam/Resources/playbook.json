      "camera": { "height": "Slightly above eye level", "angle": "Tilted slightly down", "pitchMin": 0, "pitchMax": 12 },
      "framing": { "placement": "Pair centred or on a third", "headroom": "Some space above the taller head" },
      "lighting": ["Both faces in the same light"],
      "pose": ["Angle bodies 45° toward each other", "Heads at different heights", "Front person: half-step forward", "Shoulders touching, lean in"],
